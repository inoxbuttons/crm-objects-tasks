# Фронтенд (попадает в бандл — только публичные значения)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Только для scripts/ (seed). НЕ добавлять префикс VITE_!
SUPABASE_SECRET_KEY=sb_secret_...
# Для db:push / db:types. Значение в одинарных кавычках, пароль URL-encoded
SUPABASE_DB_URL='postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres'
